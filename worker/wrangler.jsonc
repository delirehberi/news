{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "news-worker",
	"main": "src/index.tsx",
	"compatibility_date": "2026-06-29",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	"routes": [
		{
			"pattern": "news.emre.xyz",
			"custom_domain": true
		}
	],
	"d1_databases": [
		{
			"binding": "news_db",
			"database_name": "news-db",
			"database_id": "60a9e43e-5c7d-4900-842d-82b7f588d36b",
			"migrations_dir": "migrations"
		}
	],
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "news-index"
		}
	],
	"triggers": {
		"crons": [
			"0 * * * *"
		]
	},
	"ai": {
		"binding": "AI"
	},
	"vars": {
		"FRONTEND_URL": "https://news.emre.xyz",
		"USE_EMRE_THEME": "true",
		"ENABLE_HN": "true",
		"ENABLE_REDDIT": "true",
		"ENABLE_LOBSTERS": "true",
		"ENABLE_STACKER": "true",
		"ENABLE_GMAIL": "false",
		"GMAIL_SEARCH_QUERY": "label:newsletter"
	}
}
